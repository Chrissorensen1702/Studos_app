{
  "expo": {
    "name": "Studos",
    "slug": "studos",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "studos",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Studos bruger det billede, du vælger, som profilbillede eller coverbillede til en begivenhed."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Studos bruger adgang til billeder, så du kan gemme album-billeder på telefonen.",
          "savePhotosPermission": "Studos gemmer valgte album-billeder i din kamerarulle."
        }
      ],
      "expo-secure-store"
    ],
    "ios": {
      "bundleIdentifier": "dk.studenterapp.mobile",
      "icon": "./assets/icon.png",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Studos bruger det billede, du vælger, som profilbillede eller coverbillede til en begivenhed.",
        "NSPhotoLibraryAddUsageDescription": "Studos gemmer valgte album-billeder i din kamerarulle."
      }
    },
    "android": {
      "package": "dk.studenterapp.mobile",
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a2448"
      }
    },
    "androidNavigationBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#ffffff"
    },
    "extra": {
      "eas": {
        "projectId": "b4da2c62-b9cd-442c-b8da-facc8e6dc689"
      }
    },
    "owner": "chrissorensen"
  }
}
