{
  "name": "studenter-app",
  "private": true,
  "version": "0.0.0",
  "description": "Native studenter-app med web/admin og API.",
  "workspaces": [
    "apps/mobile",
    "packages/*"
  ],
  "scripts": {
    "api:dev": "php artisan serve --host=127.0.0.1 --port=8000",
    "db:init": "php artisan migrate",
    "reverb:start": "php artisan reverb:start --host=0.0.0.0 --port=8080",
    "web:dev": "php artisan serve --host=127.0.0.1 --port=8000",
    "mobile:start": "npm --workspace @studenter-app/mobile run start",
    "mobile:start:cloud": "EXPO_PUBLIC_API_URL=https://studos.laravel.cloud/api EXPO_PUBLIC_CREATE_CLASS_URL=https://studos.laravel.cloud/opret-klasse EXPO_PUBLIC_REVERB_APP_KEY=DtaoEWytkVJqPm5j3qB3 EXPO_PUBLIC_REVERB_HOST=ws-a1a50b0c-3314-49b0-9204-475481930fa9-reverb.laravel.cloud EXPO_PUBLIC_REVERB_PORT=443 EXPO_PUBLIC_REVERB_SCHEME=https npm --workspace @studenter-app/mobile run start -- --go --clear",
    "mobile:start:cloud:tunnel": "EXPO_PUBLIC_API_URL=https://studos.laravel.cloud/api EXPO_PUBLIC_CREATE_CLASS_URL=https://studos.laravel.cloud/opret-klasse EXPO_PUBLIC_REVERB_APP_KEY=DtaoEWytkVJqPm5j3qB3 EXPO_PUBLIC_REVERB_HOST=ws-a1a50b0c-3314-49b0-9204-475481930fa9-reverb.laravel.cloud EXPO_PUBLIC_REVERB_PORT=443 EXPO_PUBLIC_REVERB_SCHEME=https npm --workspace @studenter-app/mobile run start -- --go --tunnel --clear",
    "mobile:start:dev-client": "npm --workspace @studenter-app/mobile run start:dev-client",
    "mobile:ios:device": "npm --workspace @studenter-app/mobile run ios:device",
    "mobile:ios:release": "npm --workspace @studenter-app/mobile run ios:release",
    "mobile:ios:release:cloud": "EXPO_PUBLIC_API_URL=https://studos.laravel.cloud/api EXPO_PUBLIC_CREATE_CLASS_URL=https://studos.laravel.cloud/opret-klasse EXPO_PUBLIC_REVERB_APP_KEY=DtaoEWytkVJqPm5j3qB3 EXPO_PUBLIC_REVERB_HOST=ws-a1a50b0c-3314-49b0-9204-475481930fa9-reverb.laravel.cloud EXPO_PUBLIC_REVERB_PORT=443 EXPO_PUBLIC_REVERB_SCHEME=https npm run mobile:ios:release",
    "mobile:ios:prebuild": "npm --workspace @studenter-app/mobile run ios:prebuild",
    "mobile:build:android": "npm --workspace @studenter-app/mobile run build:android",
    "mobile:build:android:dev": "npm --workspace @studenter-app/mobile run build:android:dev",
    "mobile:build:ios": "npm --workspace @studenter-app/mobile run build:ios",
    "mobile:build:all": "npm --workspace @studenter-app/mobile run build:all",
    "notes": "cat README.md"
  }
}
